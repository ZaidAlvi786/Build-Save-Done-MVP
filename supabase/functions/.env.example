# DashScope Qwen vision; use an endpoint matching your API key's region.
AI_PROVIDER=dashscope
AI_MODEL=qwen3-vl-flash
AI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
# The CLI injects SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY locally.
# Supabase injects these in deployed functions; never expose service role to eval/mobile.
# Geocoding is implemented in Phase 2 behind the documented port.
GEOCODING_PROVIDER=google
GEOCODING_API_KEY=

# Server-rendered map previews; never use an EXPO_PUBLIC secret.
MAPS_STATIC_API_KEY=

# Phase 4: PostHog ingestion is server-only; use the chosen cloud region.
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=
# A random secret of at least 32 characters, also stored in Supabase Vault.
DIGEST_CRON_SECRET=
# Require Expo enhanced push security and keep its access token server-only.
EXPO_PUSH_ACCESS_TOKEN=

# Optional sanitized JS error monitoring; all credentials remain server-side.
SENTRY_PROJECT_DSN=
SENTRY_ENVIRONMENT=development
