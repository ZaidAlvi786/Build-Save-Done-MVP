{
  "expo": {
    "name": "Saved → Done",
    "slug": "saved-done",
    "version": "0.1.0",
    "scheme": "saved-done",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.saveddone.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.saveddone.app",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a screenshot of a place you want to save.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": ["image/*", "text/*"],
          "androidMultiIntentFilters": [],
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsText": true
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sort saved places near you on this phone.",
          "locationAlwaysAndWhenInUsePermission": "Remind you when you are near a place you saved. Location stays on this phone.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-notifications"
    ]
  }
}
